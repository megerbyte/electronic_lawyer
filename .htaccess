# [RECONSTRUCTED .HTACCESS]
Options -Indexes
RewriteEngine On

# Ensure the server looks for index.html as a priority
DirectoryIndex index.html index.php

# Redirect First_Contact.html to First_Contact.htm (preserve query string)
RewriteRule ^Master_Folders/Criminal/First_Contact/First_Contact\.html$ /Master_Folders/Criminal/First_Contact/First_Contact.htm [R=301,QSA,L]

# If a user requests a file without an extension (e.g., /First_Contact)
# this rule checks for the .html version FIRST and serves it.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^.]+)$ $1.html [L]

# Only if the file is truly missing does it go to the 404 handler
ErrorDocument 404 /redirect_handler.php
